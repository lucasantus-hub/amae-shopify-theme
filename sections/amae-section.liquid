              <svg width="17" height="11" viewBox="0 0 18 12" fill="none" aria-hidden="true"><path d="M1 6h16M12 1l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <p class="amae-fineprint">
              <svg viewBox="0 0 24 24" fill="none"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              Pago seguro con Stripe · IVA y envío incluidos · 48-72h
            </p>
          </div>

        </div>

        <!-- VISUALIZER -->
