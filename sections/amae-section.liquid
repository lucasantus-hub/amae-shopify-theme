              <h3 class="amae-step-ttl">De parte de</h3>
              <span class="amae-step-hint">Aparece en el móvil →</span>
            </div>
            <div class="amae-field">
              <label class="amae-field-label" for="fldFrom">Tu nombre o firma</label>
              <input class="amae-field-input" id="fldFrom" name="de_parte_de" type="text" maxlength="60" placeholder="Ej: Con amor, tus hijos">
            </div>
          </div>

          <!-- Paso 4: Textos -->
          <div class="amae-step" data-step="4">
            <div class="amae-step-head">
              <div class="amae-step-ind">
                <span class="snum">4</span>
                <svg viewBox="0 0 14 14" fill="none"><path d="M2 7.5l3.5 3L12 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <h3 class="amae-step-ttl">Textos de la galería</h3>
              <span class="amae-step-hint">En el móvil →</span>
            </div>
            <div class="amae-field">
              <label class="amae-field-label" for="fldName">A / Nombre de la persona</label>
              <input class="amae-field-input" id="fldName" name="nombre_destinatario" type="text" maxlength="40" placeholder="Ej: Mamá">
            </div>
            <div class="amae-field">
              <label class="amae-field-label" for="fldMsg">Mensaje del regalo</label>
              <textarea class="amae-field-textarea" id="fldMsg" name="mensaje" maxlength="400" placeholder="Lo que siempre quisiste decirle pero nunca supiste cómo…"></textarea>
              <span class="amae-field-count" id="msgCount">0 / 400</span>
            </div>
          </div>

          <!-- Paso 5: Email notificaciones -->
          <div class="amae-step" data-step="5">
            <div class="amae-step-head">
              <div class="amae-step-ind">
                <span class="snum">5</span>
                <svg viewBox="0 0 14 14" fill="none"><path d="M2 7.5l3.5 3L12 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <h3 class="amae-step-ttl">Tu email</h3>
              <span class="amae-step-hint">Opcional</span>
            </div>
            <div class="amae-field">
              <label class="amae-field-label" for="fldEmail">Te avisamos cuando alguien abra tu amae</label>
              <input class="amae-field-input" id="fldEmail" name="email_notificacion" type="email" placeholder="tu@correo.com">
            </div>
