              <!-- Frame blanco -->
              <div class="physical" data-physical="blanco">
                <div class="frame-body f-blanco" style="width:240px;height:310px;">
                  <div class="frame-photo-slot" data-slot="frame"><span class="placeholder">·tu foto·</span></div>
                  <div class="frame-mark">amae</div>
